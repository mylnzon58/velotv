<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VeloTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/hm_paper</item>
        <item name="android:colorBackground">@color/hm_paper</item>
        <item name="android:textColorPrimary">@color/hm_ink</item>
        <item name="android:textColorSecondary">@color/hm_ink_2</item>
        <item name="colorPrimary">@color/hm_accent</item>
        <item name="colorAccent">@color/hm_accent</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowOverscan">true</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <style name="VeloDrawerAnim">
        <item name="android:windowEnterAnimation">@anim/drawer_enter</item>
        <item name="android:windowExitAnimation">@anim/drawer_exit</item>
    </style>

    <style name="VeloModalAnim">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="VeloDrawerDialog" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.50</item>
        <item name="android:windowAnimationStyle">@style/VeloDrawerAnim</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>

    <style name="VeloModalDialog" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.64</item>
        <item name="android:windowAnimationStyle">@style/VeloModalAnim</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>
</resources>
