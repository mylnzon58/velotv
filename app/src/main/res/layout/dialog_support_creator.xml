<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/supportRoot"
    android:layout_width="760dp"
    android:layout_height="wrap_content"
    android:background="@color/hm_paper_2"
    android:orientation="horizontal"
    android:padding="34dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSupportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semibold"
            android:text="@string/support_title"
            android:textColor="@color/hm_ink"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/tvSupportBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:fontFamily="@font/outfit_regular"
            android:lineSpacingExtra="4dp"
            android:text="@string/support_body"
            android:textColor="@color/hm_ink_2"
            android:textSize="13.5sp" />

        <LinearLayout
            android:id="@+id/channelsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvCreatorCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/outfit_regular"
            android:text="@string/creator_full_credit"
            android:textColor="@color/hm_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

    <View
        android:id="@+id/supportVerticalRule"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="28dp"
        android:background="@color/hm_rule" />

    <LinearLayout
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="232dp"
            android:layout_height="232dp"
            android:background="@drawable/bg_qr_frame"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/support_scan_qr"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvQrTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/outfit_semibold"
            android:gravity="center"
            android:textColor="@color/hm_ink"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tvQrSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/outfit_medium"
            android:gravity="center"
            android:textColor="@color/hm_accent"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tvQrUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/outfit_regular"
            android:gravity="center"
            android:textColor="@color/hm_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

</LinearLayout>
