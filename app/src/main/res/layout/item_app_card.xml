<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="196dp"
    android:layout_height="112dp"
    android:layout_marginEnd="18dp"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true">

    <!-- Full-bleed edge-to-edge TV banner clipped cleanly to rounded card outline -->
    <ImageView
        android:id="@+id/ivBanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Clean Centered Icon Surface (mobile / utility apps) -->
    <LinearLayout
        android:id="@+id/iconContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvIconLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/hm_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Optional bottom banner label (only when enabled by user) -->
    <TextView
        android:id="@+id/tvBannerLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:ellipsize="end"
        android:fontFamily="@font/barlow_medium"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- Subtle editorial corner status pill -->
    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:fontFamily="@font/barlow_condensed_semibold"
        android:letterSpacing="0.06"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textSize="10sp"
        android:visibility="gone" />

</FrameLayout>
