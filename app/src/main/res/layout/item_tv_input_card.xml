<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inputRoot"
    android:layout_width="180dp"
    android:layout_height="76dp"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="14dp">

    <View
        android:id="@+id/statusBar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/hm_signal_ok" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInputTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:maxLines="1"
            android:textColor="@color/hm_ink"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tvInputSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/barlow_regular"
            android:textColor="@color/hm_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

</LinearLayout>
