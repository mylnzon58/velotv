<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hm_paper"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Layer 0: Cinema full-bleed wallpaper + multi-stop scrim + dynamic ambient color bloom -->
    <io.github.mylnzon58.velotv.ui.wallpaper.WallpaperBackdropView
        android:id="@+id/wallpaperBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: Overscan-safe foreground TV canvas -->
    <LinearLayout
        android:id="@+id/foregroundCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="24dp"
        android:paddingEnd="48dp"
        android:paddingBottom="16dp">

        <!-- Floating Cinema Top Navigation Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBrandMark"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_velo_mark" />

            <TextView
                android:id="@+id/tvWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/barlow_condensed_semibold"
                android:letterSpacing="0.10"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="@string/brand_wordmark"
                android:textColor="@color/hm_ink"
                android:textSize="22sp" />

            <View
                android:id="@+id/brandDivider"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/hm_rule" />

            <TextView
                android:id="@+id/tvStatsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_regular"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/hm_ink_2"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnClean"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/barlow_medium"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/nav_clean"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/barlow_medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/nav_search"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnWallpapers"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/barlow_medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/nav_wallpapers"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnAppHub"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/barlow_medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/nav_app_hub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSystem"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/barlow_medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/nav_system"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/barlow_medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/nav_settings"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSupport"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/barlow_medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/nav_support_short"
                android:textSize="13sp" />

            <View
                android:id="@+id/clockDivider"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="14dp"
                android:background="@color/hm_rule" />

            <LinearLayout
                android:id="@+id/clockGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_light"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="5"
                    android:textColor="@color/hm_ink"
                    android:textSize="31sp" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/barlow_regular"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="@color/hm_ink_2"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Cinema Hero Focus Strip (Breathing space lets landscape wallpaper shine) -->
        <LinearLayout
            android:id="@+id/heroFocusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="32dp"
            android:paddingEnd="6dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFocusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="@string/app_name"
                    android:textColor="@color/hm_ink"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/tvFocusMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_regular"
                    android:maxLines="1"
                    android:shadowColor="#B3000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="5"
                    android:textColor="@color/hm_ink_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFocusCue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_regular"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="@string/hint_context_cue"
                android:textColor="@color/hm_ink_2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Main Horizontal Category Rows -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rowsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:descendantFocusability="afterDescendants"
            android:paddingTop="4dp"
            android:paddingBottom="10dp" />

        <!-- Subtle Cinema Footer -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/tvBottomHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_regular"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/hint_controls"
                android:textColor="@color/hm_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvWallpaperCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_regular"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/hm_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCreatorFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_regular"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/creator_subtle_footer"
                android:textColor="@color/hm_muted"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
