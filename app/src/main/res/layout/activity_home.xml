<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hm_paper"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="24dp"
    android:paddingEnd="48dp"
    android:paddingBottom="16dp">

    <!-- Running Editorial Top Bar (No translucent pills) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBrandMark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_velo_mark" />

        <TextView
            android:id="@+id/tvWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:letterSpacing="0.10"
            android:text="@string/brand_wordmark"
            android:textColor="@color/hm_ink"
            android:textSize="23sp" />

        <View
            android:id="@+id/brandDivider"
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/hm_rule" />

        <TextView
            android:id="@+id/tvStatsBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_regular"
            android:textColor="@color/hm_muted"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/barlow_medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nav_search"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnAppHub"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/barlow_medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nav_app_hub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSystem"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/barlow_medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nav_system"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/barlow_medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nav_settings"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSupport"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/barlow_medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nav_support_short"
            android:textSize="13sp" />

        <View
            android:id="@+id/clockDivider"
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="16dp"
            android:background="@color/hm_rule" />

        <LinearLayout
            android:id="@+id/clockGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_light"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:textColor="@color/hm_ink"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_regular"
                android:textColor="@color/hm_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Crisp 1dp Structural Hairline -->
    <View
        android:id="@+id/topRule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/hm_rule" />

    <!-- Calm Focused Context Header (Apple TV / Editorial Cinema Strip) -->
    <LinearLayout
        android:id="@+id/heroFocusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFocusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_condensed_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/hm_ink"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvFocusMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_regular"
                android:maxLines="1"
                android:textColor="@color/hm_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFocusCue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_regular"
            android:text="@string/hint_context_cue"
            android:textColor="@color/hm_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Horizontal Category Rows -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:descendantFocusability="afterDescendants"
        android:paddingTop="4dp"
        android:paddingBottom="10dp" />

    <!-- Bottom Hairline & Minimal Folio Footer -->
    <View
        android:id="@+id/bottomRule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/hm_rule" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/barlow_regular"
            android:text="@string/hint_controls"
            android:textColor="@color/hm_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvCreatorFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_regular"
            android:text="@string/creator_subtle_footer"
            android:textColor="@color/hm_muted"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
