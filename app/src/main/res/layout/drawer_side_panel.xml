<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable Architectural Right-Docked Full-Height Drawer (Zero floating translucent popups) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerRoot"
    android:layout_width="520dp"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <View
        android:id="@+id/drawerLeftRule"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/hm_rule" />

    <LinearLayout
        android:id="@+id/drawerSurface"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/hm_paper_2"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvDrawerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:letterSpacing="0.03"
            android:textColor="@color/hm_ink"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvDrawerSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/barlow_regular"
            android:textColor="@color/hm_muted"
            android:textSize="13sp" />

        <!-- Optional top tabs / search input slot -->
        <LinearLayout
            android:id="@+id/drawerTopSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <View
            android:id="@+id/drawerHeaderRule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="@color/hm_rule" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/drawerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp" />
        </ScrollView>

        <View
            android:id="@+id/drawerFooterRule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/hm_rule" />

        <TextView
            android:id="@+id/tvDrawerFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_regular"
            android:textColor="@color/hm_muted"
            android:textSize="11sp" />

    </LinearLayout>
</LinearLayout>

