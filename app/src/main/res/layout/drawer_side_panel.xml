<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Soft-Rounded Right Control Panel (Apple tvOS Control Center style) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerRoot"
    android:layout_width="540dp"
    android:layout_height="match_parent"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:id="@+id/drawerSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_paper_2"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="26dp"
        android:paddingEnd="28dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/tvDrawerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semibold"
            android:textColor="@color/hm_ink"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/tvDrawerSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/outfit_regular"
            android:textColor="@color/hm_muted"
            android:textSize="13sp" />

        <!-- Optional top tabs / search input slot -->
        <LinearLayout
            android:id="@+id/drawerTopSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <View
            android:id="@+id/drawerHeaderRule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="@color/hm_rule" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="14dp" />
        </ScrollView>

        <View
            android:id="@+id/drawerFooterRule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/hm_rule" />

        <TextView
            android:id="@+id/tvDrawerFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_regular"
            android:textColor="@color/hm_muted"
            android:textSize="11.5sp" />

    </LinearLayout>
</FrameLayout>
